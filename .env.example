LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# 单次模型调用的最大输出 token，控制公开演示成本
LLM_MAX_TOKENS=1200
# 语音识别服务：在腾讯云控制台开通语音识别极速版，填入 AppID、SecretId 和 SecretKey
STT_PROVIDER=tencent
TENCENTCLOUD_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
STT_MODEL=16k_zh_en
# 如使用 OpenAI-compatible 服务，将 STT_PROVIDER 改为 openai 并填写以下配置
STT_API_KEY=
STT_BASE_URL=
# 公开演示：线索和项目只保存在访客浏览器，不写入服务器
DEMO_MODE=0
# 位于 Nginx 等反向代理之后时设为 1，按真实客户端 IP 限流
TRUST_PROXY=1
AI_RATE_LIMIT_PER_HOUR=30
STT_RATE_LIMIT_PER_HOUR=10
AI_DAILY_LIMIT=500
MAX_TRANSCRIPT_CHARS=20000
